= extend('layout')

.hero.pricing
  h2 Simple Pricing
  h4.subtitle For students, hobbyists, professionals and teams.

.hero.pricing-plans
  .container
    .row
      .col-xs-12.col-md-3
        .plan-item
          .plan-name Free
          .plan-price
            span $0
            small
              |  /mo.
          .plan-desc For learning and experimenting

          .plan-details
            ul.plan-details
              li
                | Up to 2 Projects
              li
                | 5GB Storage
              li
                | 50 hrs / mo. usage

          .plan-action
            a.btn.btn-basic.caps href="https://www.nitrous.io/app/#/signup?plan=free"
              | Sign Up

      .col-xs-12.col-md-3
        .plan-item
          .plan-name Basic
          .plan-price
            span $9
            small
              |  /mo.
          .plan-desc More sandboxed projects, no hourly restrictions.

          .plan-details
            ul.plan-details
              li
                | Up to <strong>2</strong> Projects
              li
                | 5GB Storage
              li
                | 50 hrs / mo. usage
          .plan-action
            a.btn.btn-basic.caps href="https://www.nitrous.io/app/#/signup?plan=basic"
              | Sign Up

      .col-xs-12.col-md-3
        .plan-item.selected
          .plan-name Standard
          .plan-price
            span $19
            small
              |  /mo.
          .plan-desc Keep your projects running, no hourly restrictions.

          .plan-details
            ul.plan-details
              li
                | Up to <strong>2</strong> Projects
              li
                | 5GB Storage
              li
                | 50 hrs / mo. usage
              li Always ON

          .plan-action
            a.btn.btn-default.caps href="https://www.nitrous.io/app/#/signup?plan=standard"
              | Sign Up

      .col-xs-12.col-md-3
        .plan-item
          .plan-name Professional
          .plan-price
            span $39
            small
              |  /mo.
          .plan-desc Enhanced performance for professional projects and hosting.

          .plan-details
            ul.plan-details
              li
                | Up to <strong>2</strong> Projects
              li
                | 5GB Storage
              li
                | 50 hrs / mo. usage
              li 2x Memory
              li Always ON

          .plan-action
            a.btn.btn-basic.caps href="https://www.nitrous.io/app/#/signup?plan=professional"
              | Sign Up

section.all-plans
  .container
    h5 All plans come with

    .row
      .col-xs-6.col-md-2
        i.fa.fa-check.green
        | Root Access
      .col-xs-6.col-md-2
        i.fa.fa-check.green
        | Dedicated Machine
      .col-xs-6.col-md-2
        i.fa.fa-check.green
        | Add Collaborators
      .col-xs-6.col-md-2
        i.fa.fa-check.green
        | SSH Access
      .col-xs-6.col-md-2
        i.fa.fa-check.green
        | Docker Support
      .col-xs-6.col-md-2
        i.fa.fa-check.green
        | Desktop File Sync

.container
  .more-info
    .text
      strong Organization Pricing.
      |  Org pricing starts at 2 x $39 professional workstations per monnth.
    .action
      a.btn.btn-primary href="https://www.nitrous.io/app/#/signup?intent=org" Create an Organization

.hero.education-pricing.centered
  .container
    h2 Nitrous Education Platform
    h4.subtitle A powerful API to power your course templates and student workstations.

    a.btn.btn-primary href="mailto:hello@nitrous.io?subject=API%20Pricing%20Inquiry"
      | Contact for pricing

= partial('partials/faq')
