doctype html
html
  head
    meta charset='utf-8'
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
    meta name='keywords' content='Nitrous, free, cloud IDE, code, editor, IDE, workspace, ruby, php, rails, python, docker'
    meta name='description' content='Nitrous provides a Cloud IDE and pre-configured ruby-on-rails, python, php, meteor nodejs environments built with Docker.'

    = partial('partials/og')
    = partial('partials/tcards')

    = content('title', 'default')
      title Nitrous &middot; Cloud Development Environment

    link rel='icon' href='/images/icons/favicon-32x32.ico'
    link rel='stylesheet' href='https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css'
    link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Roboto:400,300,300italic,400italic,700,700italic,900,900italic|Source+Code+Pro:400,700|Montserrat:400,700'
    link rel='stylesheet' href='/css/app.css'

    = partial('partials/optimizely.slm')
    = partial('partials/facebook.slm')

  body
    = content('body_before')
    = content('header', 'default')
      = partial('partials/navbar')
    = content()
    = content('footer', 'default')
      = partial('partials/footer')
      = partial('partials/ga.slm')

