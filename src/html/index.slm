= extend('layout')

= content('body_before', 'append')
  javascript:
    // redirect to web app if logged in
    if(localStorage.getItem('token')) {
       window.location.replace('/app/#/');
    }

main.jumbotron
  .container
    .row
      .col-md-5.col-sm-12.col-xs-12
        h1
          . One-Click
          span#stack  Ruby
          |  Setup
        p
          | No installation required. Start coding in seconds.

        button.get-started-btn.btn.btn-lg.btn-default type='button'
          | Get Started Free

      .col-md-7.hidden-xs.hidden-sm
        .embed-responsive.embed-responsive-16by9
          iframe.img-responsive src="https://player.vimeo.com/video/165062411" width="640" height="360" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen

section.hero#quickstarts
  .container
    h2 Start Coding Now with Nitrous Quickstarts
    h4.subtitle
      . Create custom templates from any GitHub project by defining your project setup in
      code
        a href="https://community.nitrous.io/docs/nitrous-quickstarts" target="_blank" nitrous.json
    .flex-list.quickstarts
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-rails"
        .logo
          img src="/images/stacks/rails.png"
        .meta
          h4 Ruby on Rails
          p.desc Rails4 with ruby, postgres and redis pre-installed.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-jekyll"
        .logo
          img src="/images/stacks/jekyll.png"
        .meta
          h4 Jekyll
          p.desc Ruby and Jekyll installed and ready to start coding.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-wordpress"
        .logo
          img src="/images/stacks/wordpress.png"
        .meta
          h4 Wordpress
          p.desc Standard Wordpress install with PHP, MySQL and Apache server.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-html5"
        .logo
          img src="/images/stacks/html5.png"
        .meta
          h4 HTML5
          p.desc A solid HTML5 skeleton start static or dynamic frontend apps.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-php-apache"
        .logo
          img src="/images/stacks/php.png"
        .meta
          h4 PHP
          p.desc Standard PHP, MySQL and Apache template on Ubuntu.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-python"
        .logo
          img src="/images/stacks/python.png"
        .meta
          h4 Python
          p.desc Python, Redis, and some other goodies.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-nodejs"
        .logo
          img src="/images/stacks/nodejs.png"
        .meta
          h4 NodeJS
          p.desc Standard NodeJS Repo. Ready to rumble.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-golang"
        .logo
          img src="/images/stacks/golang.png"
        .meta
          h4 Golang
          p.desc A sample Go 1.6.1 project running on Ubuntu.
      a.flex-item.see-more href="/quickstarts"
        p
          | See more Quickstart templates &raquo;

    .more-info
      .text
        strong Custom Quickstarts.
        |  Want to create a custom Quickstart from your own GitHub Repo?
      .action
        a.btn.btn-primary href="https://community.nitrous.io/docs/nitrous-quickstarts" Read Quickstart Docs

section.hero#use-cases
  .container
    h2 Solutions for Education, Dev Teams & Agencies.
    h4.subtitle
      | Click any of the examples below to learn more about how the Nitrous Platform can help you and your team:
    .flex-list
      a.flex-item.education href="/education"
        img src="/images/icons/education.png"
        h4 Education
        p Students start coding faster than ever. Zero setup, work from any web browser.
      a.flex-item.remote href="/orgs"
        img src="/images/icons/remote.png"
        h4 Remote Teams
        p Centralized billing and team management, snapshots and live collaboration.
      a.flex-item.agencies href="/agencies"
        img src="/images/icons/agency.png"
        h4 Agencies
        p Consistent development environments and lightning fast static site hosting with Nitrous PubStorm.

= partial('partials/cta')