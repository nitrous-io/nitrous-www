= extend('layout')

= content('title', 'append')
  title Home &middot; Nitrous

= content('body_before', 'append')
  javascript:
    // redirect to web app if logged in
    if(localStorage.getItem('token')) {
       window.location.replace('/app/#/');
    }

main.jumbotron
  .container
    .row
      .col-md-5.col-sm-12.col-xs-12
        h1
          | Start Coding
          br
          | Powerful Apps in Seconds
        p
          | No installation required. Create a new environment with our cloud IDE in seconds.

        button.get-started-btn.btn.btn-lg.btn-primary type='button'
          | Get Started Free

      .col-md-7.hidden-xs.hidden-sm#apps
        .browser.window
          .titlebar
            .control
            .control
            .control
            .left-nav-btn.titlebar-btn.hidden-xs
              i.fa.fa-chevron-left
            .right-nav-btn.titlebar-btn.hidden-xs
              i.fa.fa-chevron-right
            .url-field.titlebar-btn
              i.fa.fa-lock.green
              span.green https
              | ://www.nitrous.io/projects/new
          .window-body
            .new-project
              h4 New Project
              .input
                span#stack
                  |
                span.cursor

            .templates-grid.flex-list
              #rails.flex-item
                .logo
                  img src="/images/stacks/rails.png"
                .name
                  | Ruby on Rails
              #django.flex-item
                .logo
                  img src="/images/stacks/django.png"
                .name
                  | Django
              #php.flex-item
                .logo
                  img src="/images/stacks/php.png"
                .name
                  | PHP (LAMP)
              #meteor.flex-item
                .logo
                  img src="/images/stacks/meteor.png"
                .name
                  | Meteor
              #wordpress.flex-item
                .logo
                  img src="/images/stacks/wordpress.png"
                .name
                  | Wordpress
              #python.flex-item
                .logo
                  img src="/images/stacks/python.png"
                .name
                  | Python
              #node.flex-item
                .logo
                  img src="/images/stacks/nodejs.png"
                .name
                  | Node.js
              #go.flex-item
                .logo
                  img src="/images/stacks/golang.png"
                .name
                  | Go
              #jekyll.flex-item
                .logo
                  img src="/images/stacks/jekyll.png"
                .name
                  | Jekyll

section.hero.featurette.peakaboo#solo
  .container-fluid
    h2 Best-in-class Cloud IDE
    h4.subtitle
      | Intelligent auto-complete, live collaboration, beautiful themes and deployment from your web browser.

    .row
      .col-xs-12.col-md-6.col-lg-4.col-xl-4
        img.img-fluid.center-block src="/images/ide/ide-ft-1.png" style="max-height: 500px;"
      .hidden-xs.hidden-sm.col-md-6.col-lg-4
        img.img-fluid.center-block src="/images/ide/ide-ft-2.png" style="max-height: 500px;"
      .hidden-xs.hidden-sm.hidden-md.col-lg-4
        img.img-fluid.center-block src="/images/ide/ide-ft-3.png" style="max-height: 500px;"


section.hero#quickstarts
  .container
    h2 Start Coding Now with Nitrous Quickstarts
    h4.subtitle
      . Create custom templates from any GitHub project by defining your project setup in
      code
        a href="https://community.nitrous.io/docs/nitrous-quickstarts" target="_blank" nitrous.json
    .flex-list.quickstarts
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-rails"
        .logo
          img src="/images/stacks/rails.png"
        .meta
          h4 Ruby on Rails
          p.desc Rails4 with ruby, postgres and redis pre-installed.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-jekyll"
        .logo
          img src="/images/stacks/jekyll.png"
        .meta
          h4 Jekyll
          p.desc Ruby and Jekyll installed and ready to start coding.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-wordpress"
        .logo
          img src="/images/stacks/wordpress.png"
        .meta
          h4 Wordpress
          p.desc Standard Wordpress install with PHP, MySQL and Apache server.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-html5"
        .logo
          img src="/images/stacks/html5.png"
        .meta
          h4 HTML5
          p.desc A solid HTML5 skeleton start static or dynamic frontend apps.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-php-apache"
        .logo
          img src="/images/stacks/php.png"
        .meta
          h4 PHP
          p.desc Standard PHP, MySQL and Apache template on Ubuntu.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-python"
        .logo
          img src="/images/stacks/python.png"
        .meta
          h4 Python
          p.desc Python, Redis, and some other goodies.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-nodejs"
        .logo
          img src="/images/stacks/nodejs.png"
        .meta
          h4 NodeJS
          p.desc Standard NodeJS Repo. Ready to rumble.
      a.flex-item href="https://www.nitrous.io/quickstart?repo=https://github.com/nitrous-io/example-golang"
        .logo
          img src="/images/stacks/golang.png"
        .meta
          h4 Golang
          p.desc A sample Go 1.6.1 project running on Ubuntu.
      a.flex-item.see-more href="/quickstarts"
        p
          | See more Quickstart templates &raquo;

    .more-info
      .text
        strong Custom Quickstarts.
        |  Want to create a custom Quickstart from your own GitHub Repo?
      .action
        a.btn.btn-primary href="https://community.nitrous.io/docs/nitrous-quickstarts" Read Quickstart Docs

section.hero#pubstorm-demo
  .container
    h2 Nitrous PubStorm
    h4.subtitle
      | Lightning Fast, Free Website Hosting for Front-end Developers

    .terminal.window
      .titlebar
        .control
        .control
        .control
      .window-body
        code
          span.cli
            span.t1
              span.prompt >
              =' '
            span.t2 storm publish
            span.t3
              br
              | Scanning "/Users/erin/erins-blog"...
            span.t4
              br
              span.blue
                | [Info]
              |  Bundling 37 files (17.3 MiB)...
            span.t5
              br
              br
              | Packing bundle "erins-blog"...
              br
              | [
              span.blue.cli-progress-bar
                | ========================================
              | ]
              =' '
              span.cyan
                span.cli-progress-percentage 100.0
                | %
            span.t6
              br
              br
              | Uploading bundle "erins-blog" to PubStorm Cloud...
              br
              | [
              span.blue.cli-progress-bar
                | ========================================
              | ]
              =' '
              span.cyan
                span.cli-progress-percentage 100.0
                | %
            span.t7
              br
              br
              | Launching v1...
            span.t8
              br
              span.blue
                | [Info]
              |  Successfully published "erins-blog" on PubStorm Cloud.
              br
              | =>
              = ' '
              ins erins-blog.pubstorm.site
              br
              span.prompt >
              =' '
          span.cursor
    .browser.window
      .titlebar
        .control
        .control
        .control
        .left-nav-btn.titlebar-btn.hidden-xs
          i.fa.fa-chevron-left
        .right-nav-btn.titlebar-btn.hidden-xs
          i.fa.fa-chevron-right
        .url-field.titlebar-btn
          span erins-blog.pubstorm.site
      .window-body
        .blog

    .row
      .col-xs-12
        p.centered style="padding-top: 20px"
          a.btn.btn-default href="https://www.pubstorm.com/#get-started"
            . Create Your Free PubStorm Website
            i.fa.fa-chevron-right
