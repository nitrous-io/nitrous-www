= extend('/layout')

= content('title', 'append')
  title PubStorm &middot; Nitrous

.hero.main.notice-after
  .container
    h2 Nitrous PubStorm
    h4.subtitle Free HTML5 Web Publishing and Hosting for Developers
    .input-group.input-group-lg
      span.input-group-btn
        button.copy-npm-cmd-btn.btn.btn-default.btn-lg(type='button' data-toggle='tooltip' data-placement='bottom' title='Copy to clipboard')
          i.fa.fa-clipboard
      input.form-control.npm-cmd(type='text' readonly=true value='npm install -g pubstorm')

.notice
  .container
    p
      span.label.label-primary FREE
      | Publishing your first site is free and takes 60 seconds.
      a href="http://help.pubstorm.com/getting-started/getting_started"  Read the docs
      i.fa.fa-chevron-right.blue

section#pubstorm-features
  .container
    .row
      .feature.col-xs-12.col-sm-6.col-md-4
        i.fa.fa-globe
        h3 Production Grade CDN
        p Our CDN provides quick pageloads to visitors around the globe.
      .feature.col-xs-12.col-sm-6.col-md-4
        i.fa.fa-tachometer
        h3 Infinitely Scalable
        p Our cloud automatically scales to handle any amount of traffic.
      .feature.col-xs-12.col-sm-6.col-md-4
        i.fa.fa-file-archive-o
        h3 Asset Optimization
        p Your files are automatically processed for size and speed.

      .clearfix.visible-md-block.visible-lg-block

      .feature.col-xs-12.col-sm-6.col-md-4
        i.fa.fa-map-signs
        h3 Custom Domains
        p Have a piece of the Internet with your own domain name.
      .feature.col-xs-12.col-sm-6.col-md-4
        i.fa.fa-undo
        h3 Backups and Rollbacks
        p Made a mistake? Undo it instantly before anyone notices.
      .feature.col-xs-12.col-sm-6.col-md-4
        i.fa.fa-bar-chart
        h3 Visitor Statistics
        p Monitor and learn more about your website traffic.

section#pubstorm-tools
  .container
    h2 Works with the tools you love

    ul
      li.html5
        span.sr-only HTML5
      li.js
        span.sr-only JavaScript
      li.jekyll
        span.sr-only Jekyll
      li.hexo
        span.sr-only Hexo
      li.middleman
        span.sr-only Middleman
      li.separator.hidden-xs
      li.hugo
        span.sr-only Hugo
      li.ember
        span.sr-only Ember
      li.react
        span.sr-only React
      li.angular
        span.sr-only Angular
      li.gulp
        span.sr-only Gulp
      li.grunt
        span.sr-only Grunt

= partial('/partials/pubstorm-cta')
